---
import BaseLayout from '../layouts/BaseLayout.astro';
import { researchEntries } from '../data/siteContent';
import ResearchCard from '../components/ResearchCard.astro';
const base = import.meta.env.BASE_URL;
const featuredEntries = researchEntries.slice(0, 3);
---
<BaseLayout title="A living map of ideas" description="A research-first personal website for quantum gravity, theoretical physics, writing, media, and art.">
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow kicker">A personal research archive & creative notebook</span>
        <h1>Following the thread from <em>gravity</em> to everything underneath.</h1>
        <p class="hero-copy">A home for questions in <strong>quantum gravity, AdS/CFT, and theoretical physics</strong> — alongside the notes, writing, images, and experiments that make up the rest of a life.</p>
        <div class="button-row">
          <a class="button" href={`${base}research/`}>Explore the research archive <span aria-hidden="true">↗</span></a>
          <a class="button secondary" href={`${base}about/`}>A little about me</a>
        </div>
        <div class="hero-note">Research first. Everything else has a place, too.</div>
      </div>
      <div class="hero-art" aria-label="Abstract orbital illustration" role="img">
        <div class="orbit-panel">
          <span class="hero-sticker">notes<br />on the<br />fundamental</span>
          <svg class="orbit-shape" viewBox="0 0 420 420" aria-hidden="true">
            <defs>
              <linearGradient id="orbitalFill" x1="0" x2="1" y1="0" y2="1"><stop offset="0" stop-color="#f7f5ed"/><stop offset="1" stop-color="#d8e2d4"/></linearGradient>
            </defs>
            <circle cx="210" cy="210" r="142" fill="url(#orbitalFill)" opacity=".9" />
            <circle cx="210" cy="210" r="116" fill="none" stroke="#263f3b" stroke-width="1" stroke-dasharray="3 7" opacity=".6" />
            <ellipse cx="210" cy="210" rx="166" ry="57" fill="none" stroke="#263f3b" stroke-width="2" transform="rotate(-37 210 210)" />
            <ellipse cx="210" cy="210" rx="166" ry="57" fill="none" stroke="#263f3b" stroke-width="2" transform="rotate(38 210 210)" />
            <ellipse cx="210" cy="210" rx="152" ry="95" fill="none" stroke="#d77e67" stroke-width="3" transform="rotate(90 210 210)" />
            <path d="M78 250 C112 170, 155 132, 211 137 S317 180, 342 113" stroke="#4a7760" stroke-width="3" fill="none" stroke-linecap="round" />
            <circle cx="210" cy="210" r="30" fill="#e6bd59" />
            <circle cx="210" cy="210" r="8" fill="#263f3b" />
            <circle cx="327" cy="151" r="7" fill="#d77e67" />
            <circle cx="127" cy="111" r="7" fill="#4a7760" />
            <circle cx="108" cy="288" r="5" fill="#263f3b" />
            <path d="M188 210 h44 M210 188 v44" stroke="#263f3b" stroke-width="1" opacity=".4" />
          </svg>
          <div class="orbit-caption"><span>Open notebook / 001</span><strong>Keep asking<br />better questions.</strong></div>
        </div>
      </div>
    </div>
    <div class="container hero-bottomline"><span>Quantum gravity / AdS-CFT / High-energy theory</span><span>Calculations · questions · creative life</span></div>
  </section>

  <section class="section tinted-section">
    <div class="container">
      <div class="section-heading" data-reveal>
        <div><span class="eyebrow kicker">The map</span><h2>One person. Several kinds of curiosity.</h2></div>
        <p>Research is the spine of this site. The other sections give the rest of the work — and the person doing it — room to breathe.</p>
      </div>
      <div class="area-grid">
        <a class="area-card" href={`${base}research/`} data-reveal>
          <div class="area-card-top"><span class="area-icon">∿</span><span class="area-index">01 / CORE</span></div>
          <div><h3>Research & academia</h3><p>Projects, papers, technical derivations, reading maps, and presentations — linked together rather than scattered.</p></div>
          <div class="area-card-bottom"><span>Enter the archive</span><b>↗</b></div>
        </a>
        <a class="area-card" href={`${base}writings/`} data-reveal>
          <div class="area-card-top"><span class="area-icon">✳</span><span class="area-index">02 / WORDS</span></div>
          <div><h3>Writings & ideas</h3><p>Essays, Medium articles, recommendations, worldview, ambitions, and thoughts still finding their shape.</p></div>
          <div class="area-card-bottom"><span>Browse writing</span><b>↗</b></div>
        </a>
        <a class="area-card" href={`${base}channels/`} data-reveal>
          <div class="area-card-top"><span class="area-icon">▷</span><span class="area-index">03 / MEDIA</span></div>
          <div><h3>Channels & media</h3><p>A useful introduction to four YouTube channels and an Instagram account, with their purpose and content.</p></div>
          <div class="area-card-bottom"><span>See what I make</span><b>↗</b></div>
        </a>
        <a class="area-card" href={`${base}art/`} data-reveal>
          <div class="area-card-top"><span class="area-icon">◒</span><span class="area-index">04 / STUDIO</span></div>
          <div><h3>Art & photography</h3><p>Photographs, paintings, visual experiments, and unfinished things worth keeping.</p></div>
          <div class="area-card-bottom"><span>Visit the studio</span><b>↗</b></div>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading" data-reveal>
        <div><span class="eyebrow kicker">Research, made navigable</span><h2>A place for the finished, the unfinished, and the still uncertain.</h2></div>
        <p>The archive distinguishes papers from notes, projects from interests, and polished work from exploratory calculations. Clear status labels give each item the right context.</p>
      </div>
      <div class="notice" data-reveal><span class="notice-mark">i</span><div><strong>Prototype content is marked as sample.</strong> These records demonstrate how the archive works; they are not claims that a paper exists or that a calculation has been completed. Replace them with your own material before sharing the site publicly.</div></div>
      <div class="research-grid">
        {featuredEntries.map((entry) => <ResearchCard entry={entry} />)}
      </div>
      <div class="button-row"><a class="button" href={`${base}research/`}>View the complete archive ↗</a></div>
    </div>
  </section>

  <section class="closing-banner">
    <div class="container closing-inner">
      <div><span class="eyebrow">An evolving body of work</span><h2>Not a finished portrait. A working map.</h2></div>
      <a class="button" href={`${base}about/`}>Explore the site’s purpose ↗</a>
    </div>
  </section>
</BaseLayout>
