
---
import BaseLayout from '../../layouts/BaseLayout.astro';

const zenodoSearchUrl =
  'https://zenodo.org/search?q=metadata.creators.person_or_org.name%3A%22Deshmukh%2C%20Shivraj%22&l=list&p=1&s=10&sort=bestmatch';
---

<BaseLayout title="Research" description="Research, technical work, study notes, and academic materials.">
  <main class="research-page">
    <header class="hero">
      <div class="hero-copy">
        <p class="eyebrow"><span class="eyebrow-dot"></span> RESEARCH / ARCHIVE</p>
        <h1>Ideas in progress.<br /><em>Questions without shortcuts.</em></h1>
        <p class="intro-copy">
          An evolving collection of my work in theoretical physics, quantum gravity,
          AdS/CFT, and related subjects — from research records to calculations,
          study notes, and academic material.
        </p>
        <a class="hero-link" href="#archive">EXPLORE THE ARCHIVE <span>↓</span></a>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="orbit orbit-one"></div>
        <div class="orbit orbit-two"></div>
        <div class="orbit orbit-three"></div>
        <div class="orbit-core">QG</div>
        <span class="art-label art-label-one">01 / THEORY</span>
        <span class="art-label art-label-two">OPEN QUESTIONS</span>
        <span class="art-label art-label-three">∞</span>
      </div>
    </header>

    <section class="publications-section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">01 — RESEARCH OUTPUT</p>
          <h2>Peer-reviewed publications</h2>
        </div>
        <span class="section-note">NO ENTRIES LISTED</span>
      </div>

      <div class="empty-state">
        <span class="empty-icon">↗</span>
        <div>
          <h3>No peer-reviewed publications listed yet.</h3>
          <p>
            Preprints, deposited records, notes, and other work are listed
            separately below. A Zenodo deposit is not automatically a
            peer-reviewed publication.
          </p>
        </div>
      </div>
    </section>

    <section id="archive" class="archive-section">
      <div class="section-heading archive-heading">
        <div>
          <p class="eyebrow">02 — OPEN ARCHIVE</p>
          <h2>Research &amp; academic work<span class="heading-period">.</span></h2>
          <p class="section-copy">
            Browse the materials by subject or record type. Each entry links to
            its source record, with a PDF or DOI link when available. Categories
            describe the deposited material; they do not imply peer review,
            acceptance, or completion.
          </p>
        </div>
        <a class="text-link" href={zenodoSearchUrl} target="_blank" rel="noreferrer">
          OPEN ZENODO ↗
        </a>
      </div>

      <div class="filters">
        <label class="filter-control search-control">
          <span>FIND SOMETHING</span>
          <input id="archive-search" type="search" placeholder="Try a topic, title, or keyword..." />
        </label>
        <label class="filter-control">
          <span>MATERIAL TYPE</span>
          <select id="type-filter">
            <option value="all">All material types</option>
            <option value="preprint">Preprints</option>
            <option value="research">Research / technical work</option>
            <option value="study">Study notes / learning material</option>
            <option value="presentation">Presentations</option>
            <option value="writing">Academic writing</option>
            <option value="software">Software / simulations</option>
            <option value="other">Other / unspecified</option>
          </select>
        </label>
        <label class="filter-control">
          <span>RECORD STATUS</span>
          <select id="status-filter">
            <option value="all">All statuses</option>
            <option value="preprint">Preprint</option>
            <option value="available">Available on Zenodo</option>
          </select>
        </label>
      </div>

      <div class="results-bar">
        <p id="results-count" aria-live="polite">LOADING ARCHIVE…</p>
        <button id="reset-filters" type="button">RESET FILTERS ↺</button>
      </div>

      <p id="archive-message" class="archive-message" role="status">
        Retrieving records from Zenodo…
      </p>

      <div id="archive-grid" class="archive-grid"></div>

      <footer class="archive-footer">
        <p>
          Categories are based on Zenodo's resource-type metadata where possible.
          “Available on Zenodo” means the record is accessible; it does not imply
          peer review, completion, or acceptance. Records are filtered by creator
          name and a specific excluded record ID.
        </p>
        <a href={zenodoSearchUrl} target="_blank" rel="noreferrer">
          VIEW ZENODO SEARCH ↗
        </a>
      </footer>
    </section>

    <section class="about-archive">
      <p class="eyebrow">03 — HOW TO READ THIS ARCHIVE</p>
      <h2>Not all work is the same kind of work.</h2>
      <p class="section-copy guide-intro">
        This archive brings together different kinds of academic activity while
        keeping their distinctions visible. A deposited item may be exploratory,
        technical, educational, or research-oriented; its presence here does not
        by itself establish its scholarly status.
      </p>
      <div class="guide-grid">
        <article class="guide-card guide-teal">
          <span class="guide-number">01</span>
          <h3>Research</h3>
          <p>Research records, preprints, technical work, and calculations.</p>
          <span class="guide-decoration">∮</span>
        </article>
        <article class="guide-card guide-coral">
          <span class="guide-number">02</span>
          <h3>Study &amp; exploration</h3>
          <p>Study notes, notebooks, and material developed while learning a subject.</p>
          <span class="guide-decoration">∂</span>
        </article>
        <article class="guide-card guide-lilac">
          <span class="guide-number">03</span>
          <h3>Other material</h3>
          <p>Software, presentations, academic writing, and records without a clear subtype.</p>
          <span class="guide-decoration">∞</span>
        </article>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  type MaterialType =
    | 'preprint'
    | 'research'
    | 'study'
    | 'presentation'
    | 'writing'
    | 'software'
    | 'other';

  type RecordStatus = 'preprint' | 'available';

  type Creator = {
    name?: string;
    person_or_org?: {
      name?: string;
      given_name?: string;
      family_name?: string;
    };
  };

  type ZenodoFile = {
    key?: string;
    filename?: string;
    links?: { self?: string; download?: string };
  };

  type ZenodoRecord = {
    id?: number;
    doi?: string;
    title?: string;
    description?: string;
    publication_date?: string;
    created?: string;
    resource_type?: { title?: string; type?: string; subtype?: string };
    metadata?: {
      title?: string;
      description?: string;
      publication_date?: string;
      resource_type?: { title?: string; type?: string; subtype?: string };
      creators?: Creator[];
      keywords?: string[];
      subjects?: Array<{ subject?: string }>;
    };
    creators?: Creator[];
    links?: { html?: string; self_html?: string; doi?: string };
    files?: ZenodoFile[] | {
      entries?: Record<string, ZenodoFile>;
    };
    keywords?: string[];
    subjects?: Array<{ subject?: string }>;
  };

  type ArchiveEntry = {
    id: string;
    title: string;
    description: string;
    date: string;
    timestamp: number;
    type: MaterialType;
    typeLabel: string;
    status: RecordStatus;
    statusLabel: string;
    keywords: string[];
    recordUrl: string;
    doiUrl: string;
    pdfUrl: string;
    searchable: string;
  };

  const ZENODO_API = 'https://zenodo.org/api/records/';

  // Exclude only this record. All other records still pass through the
  // existing creator-name filter.
  const EXCLUDED_RECORD_IDS = new Set(['20338950']);

  const grid = document.querySelector<HTMLDivElement>('#archive-grid');
  const message = document.querySelector<HTMLParagraphElement>('#archive-message');
  const resultsCount = document.querySelector<HTMLParagraphElement>('#results-count');
  const searchInput = document.querySelector<HTMLInputElement>('#archive-search');
  const typeFilter = document.querySelector<HTMLSelectElement>('#type-filter');
  const statusFilter = document.querySelector<HTMLSelectElement>('#status-filter');
  const resetButton = document.querySelector<HTMLButtonElement>('#reset-filters');

  let records: ArchiveEntry[] = [];

  function escapeHtml(value: string): string {
    return value.replace(/[&<>"']/g, (character) => {
      const entities: Record<string, string> = {
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;',
      };
      return entities[character] ?? character;
    });
  }

  function metadataOf(record: ZenodoRecord) {
    return record.metadata ?? record;
  }

  function creatorNames(record: ZenodoRecord): string[] {
    const metadata = metadataOf(record);
    return (metadata.creators ?? record.creators ?? []).map((creator) => {
      if (creator.person_or_org?.name) return creator.person_or_org.name;
      if (creator.name) return creator.name;
      if (creator.person_or_org) {
        return [
          creator.person_or_org.given_name,
          creator.person_or_org.family_name,
        ].filter(Boolean).join(' ');
      }
      return '';
    });
  }

  function belongsToAuthor(record: ZenodoRecord): boolean {
    return creatorNames(record).some((name) => {
      const normalized = name.toLowerCase().replace(/[.,]/g, ' ');
      return normalized.includes('shivraj') && normalized.includes('deshmukh');
    });
  }

  function cleanDescription(input: string): string {
    const element = document.createElement('div');
    element.innerHTML = input;
    return (element.textContent ?? '').replace(/\s+/g, ' ').trim();
  }

  function recordDetails(record: ZenodoRecord) {
    const metadata = metadataOf(record);
    const title = metadata.title ?? record.title ?? 'Untitled record';
    const description = cleanDescription(metadata.description ?? record.description ?? '');
    const keywords = [
      ...(metadata.keywords ?? record.keywords ?? []),
      ...(metadata.subjects ?? record.subjects ?? []).map((subject) => subject.subject ?? ''),
    ].filter(Boolean);

    const resource = metadata.resource_type ?? record.resource_type ?? {};
    const resourceType = (resource.type ?? '').toLowerCase();
    const subtype = (resource.subtype ?? '').toLowerCase();
    const resourceTitle = (resource.title ?? '').toLowerCase();

    return { title, description, keywords, resourceType, subtype, resourceTitle };
  }

  function classifyType(details: ReturnType<typeof recordDetails>): {
    type: MaterialType;
    label: string;
  } {
    const subtype = details.subtype;
    const resourceType = details.resourceType;
    const resourceTitle = details.resourceTitle;
    const text = `${details.title} ${details.description}`.toLowerCase();

    if (subtype === 'preprint' || subtype === 'workingpaper' || subtype === 'working paper') {
      return { type: 'preprint', label: 'PREPRINT' };
    }

    if (
      subtype === 'presentation' ||
      (subtype === 'conferencepaper' && /slides|presentation/.test(text)) ||
      /^(presentation|lecture slides|slide deck)$/.test(details.title.trim().toLowerCase())
    ) {
      return { type: 'presentation', label: 'PRESENTATION' };
    }

    if (
      resourceType === 'software' ||
      subtype === 'software' ||
      /\b(simulation toolkit|software package|source code repository)\b/.test(text)
    ) {
      return { type: 'software', label: 'SOFTWARE / SIMULATION' };
    }

    if (
      subtype === 'lecture' ||
      subtype === 'lesson' ||
      subtype === 'learning resource' ||
      /^(study notes|lecture notes|student notebook|study notebook)\b/.test(details.title.trim().toLowerCase())
    ) {
      return { type: 'study', label: 'STUDY / LEARNING MATERIAL' };
    }

    if (
      subtype === 'technicalnote' ||
      subtype === 'technical note' ||
      subtype === 'report' ||
      subtype === 'thesis'
    ) {
      return { type: 'research', label: 'RESEARCH / TECHNICAL WORK' };
    }

    if (
      resourceType === 'publication' &&
      ['article', 'book', 'section', 'conferencepaper', 'preprint', 'workingpaper'].includes(subtype)
    ) {
      if (subtype === 'preprint' || subtype === 'workingpaper') {
        return { type: 'preprint', label: 'PREPRINT' };
      }
      return { type: 'writing', label: 'ACADEMIC WRITING' };
    }

    if (resourceTitle.includes('presentation') || resourceTitle.includes('lecture')) {
      return { type: 'presentation', label: 'PRESENTATION / LECTURE' };
    }

    if (
      resourceType === 'dataset' ||
      resourceType === 'image' ||
      resourceType === 'video' ||
      resourceType === 'other' ||
      resourceType === 'physicalobject'
    ) {
      return { type: 'other', label: 'OTHER MATERIAL' };
    }

    return { type: 'other', label: 'OTHER / UNSPECIFIED' };
  }

  function filesOf(record: ZenodoRecord): ZenodoFile[] {
    if (Array.isArray(record.files)) return record.files;
    if (record.files?.entries) {
      return Object.entries(record.files.entries).map(([key, file]) => ({
        ...file,
        key: file.key ?? key,
      }));
    }
    return [];
  }

  function getPdfUrl(record: ZenodoRecord): string {
    const pdf = filesOf(record).find((file) =>
      (file.filename ?? file.key ?? '').toLowerCase().endsWith('.pdf'),
    );
    return pdf?.links?.self ?? pdf?.links?.download ?? '';
  }

  function normalizeRecord(record: ZenodoRecord): ArchiveEntry {
    const details = recordDetails(record);
    const typeInfo = classifyType(details);
    const status: RecordStatus = typeInfo.type === 'preprint' ? 'preprint' : 'available';
    const statusLabel = status === 'preprint' ? 'PREPRINT' : 'ON ZENODO';

    const rawDate =
      record.metadata?.publication_date ??
      record.publication_date ??
      record.created ??
      '';

    const parsedDate = rawDate ? new Date(rawDate) : null;
    const timestamp = parsedDate && !Number.isNaN(parsedDate.getTime())
      ? parsedDate.getTime()
      : 0;

    const date = timestamp
      ? new Date(timestamp).toLocaleDateString('en', {
          year: 'numeric',
          month: 'short',
          day: 'numeric',
        })
      : 'Date unavailable';

    const recordUrl =
      record.links?.html ??
      record.links?.self_html ??
      (record.id ? `https://zenodo.org/records/${record.id}` : '');

    const doiUrl = record.doi
      ? `https://doi.org/${record.doi}`
      : record.links?.doi ?? '';

    return {
      id: String(record.id ?? record.doi ?? details.title),
      title: details.title,
      description: details.description || 'No description was provided for this record.',
      date,
      timestamp,
      type: typeInfo.type,
      typeLabel: typeInfo.label,
      status,
      statusLabel,
      keywords: [...new Set(details.keywords)].slice(0, 5),
      recordUrl: recordUrl || 'https://zenodo.org/',
      doiUrl,
      pdfUrl: getPdfUrl(record),
      searchable: [
        details.title,
        details.description,
        ...details.keywords,
        typeInfo.label,
        statusLabel,
      ].join(' ').toLowerCase(),
    };
  }

  function renderCards(items: ArchiveEntry[]) {
    if (!grid || !message || !resultsCount) return;

    resultsCount.textContent = `SHOWING ${items.length} OF ${records.length} RECORDS`;

    if (items.length === 0) {
      grid.innerHTML = '';
      message.hidden = false;
      message.textContent = records.length
        ? 'Nothing matches these filters. Try another search or reset the filters.'
        : 'No matching records were found.';
      return;
    }

    message.hidden = true;

    grid.innerHTML = items.map((entry, index) => {
      const title = escapeHtml(entry.title);
      const description = escapeHtml(entry.description);
      const recordUrl = escapeHtml(entry.recordUrl);
      const date = escapeHtml(entry.date);

      const keywords = entry.keywords.map((keyword) =>
        `<span class="keyword">${escapeHtml(keyword)}</span>`
      ).join('');

      const links = [
        entry.pdfUrl
          ? `<a href="${escapeHtml(entry.pdfUrl)}" target="_blank" rel="noreferrer">READ PDF ↗</a>`
          : '',
        entry.doiUrl
          ? `<a href="${escapeHtml(entry.doiUrl)}" target="_blank" rel="noreferrer">DOI ↗</a>`
          : '',
        `<a href="${recordUrl}" target="_blank" rel="noreferrer">ZENODO RECORD ↗</a>`,
      ].filter(Boolean).join('');

      return `
        <article class="archive-card card-tone-${index % 4}">
          <div class="card-top">
            <span class="material-type">${escapeHtml(entry.typeLabel)}</span>
            <span class="status status-${entry.status}">${escapeHtml(entry.statusLabel)}</span>
          </div>
          <h3><a href="${recordUrl}" target="_blank" rel="noreferrer">${title}</a></h3>
          <p class="card-description">${description}</p>
          <div class="card-meta">
            <span>${date}</span>
            <span class="record-indicator">ZENODO RECORD</span>
          </div>
          ${keywords ? `<div class="keyword-list">${keywords}</div>` : ''}
          <div class="card-bottom">
            <div class="card-links">${links}</div>
          </div>
          <span class="card-index" aria-hidden="true">${String(index + 1).padStart(2, '0')}</span>
        </article>
      `;
    }).join('');
  }

  function applyFilters() {
    const query = searchInput?.value.trim().toLowerCase() ?? '';
    const selectedType = typeFilter?.value ?? 'all';
    const selectedStatus = statusFilter?.value ?? 'all';

    const filtered = records.filter((record) =>
      (!query || record.searchable.includes(query)) &&
      (selectedType === 'all' || record.type === selectedType) &&
      (selectedStatus === 'all' || record.status === selectedStatus)
    );

    renderCards(filtered);
  }

  async function loadArchive() {
    if (!grid || !message || !resultsCount) return;

    const apiUrl = new URL(ZENODO_API);
    apiUrl.searchParams.set('q', 'creators.name:"Deshmukh, Shivraj"');
    apiUrl.searchParams.set('size', '25');
    apiUrl.searchParams.set('sort', 'mostrecent');

    try {
      const response = await fetch(apiUrl.toString(), {
        headers: { Accept: 'application/json' },
      });

      if (!response.ok) {
        throw new Error(`Zenodo returned HTTP ${response.status}`);
      }

      const data = await response.json() as {
        hits?: { hits?: ZenodoRecord[]; total?: number };
      };

      records = (data.hits?.hits ?? [])
        .filter((record) => !EXCLUDED_RECORD_IDS.has(String(record.id ?? '')))
        .filter(belongsToAuthor)
        .map(normalizeRecord)
        .sort((a, b) => b.timestamp - a.timestamp);

      if (records.length === 0) {
        throw new Error('No records matched the author filter in this API response.');
      }

      applyFilters();
    } catch (error) {
      console.error('Zenodo archive error:', error);
      grid.innerHTML = '';
      resultsCount.textContent = 'ARCHIVE UNAVAILABLE';
      message.hidden = false;
      message.innerHTML = `
        <strong>Zenodo records could not be loaded automatically.</strong>
        <span>You can still view the record list on Zenodo.</span>
        <a href="${zenodoSearchUrl}" target="_blank" rel="noreferrer">
          OPEN ZENODO RECORDS ↗
        </a>
      `;
    }
  }

  searchInput?.addEventListener('input', applyFilters);
  typeFilter?.addEventListener('change', applyFilters);
  statusFilter?.addEventListener('change', applyFilters);

  resetButton?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    if (typeFilter) typeFilter.value = 'all';
    if (statusFilter) statusFilter.value = 'all';
    applyFilters();
  });

  void loadArchive();
</script>

<style is:global>
  .research-page {
    --paper: #f7f5ed;
    --card: #fffef9;
    --ink: #153e3c;
    --muted: #536d68;
    --line: #d5dbd1;
    --teal: #226c65;
    --coral: #c76850;
    --gold: #d4a94e;
    --lilac: #a18acb;

    width: min(calc(100% - 5rem), 1140px);
    margin: 0 auto;
    padding: 4.2rem 0 7rem;
    color: var(--ink);
  }

  .research-page .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(260px, 0.6fr);
    align-items: center;
    gap: 2rem;
    min-height: 370px;
    margin-bottom: 5rem;
    padding: 3rem;
    overflow: hidden;
    border: 1px solid #d5dbd1;
    background:
      radial-gradient(ellipse at 90% 10%, rgb(226 191 132 / 26%), transparent 36%),
      radial-gradient(ellipse at 5% 95%, rgb(97 157 143 / 16%), transparent 40%),
      #fbfaf4;
  }

  .research-page .hero-copy { position: relative; z-index: 2; }

  .research-page .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 1rem;
    color: var(--muted);
    font-family: var(--font-mono, monospace);
    font-size: 0.67rem;
    letter-spacing: 0.13em;
    line-height: 1.6;
  }

  .research-page .eyebrow-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--coral);
    box-shadow: 0 0 0 4px rgb(199 104 80 / 13%);
  }

  .research-page .hero h1 {
    max-width: 700px;
    margin: 0;
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(2.8rem, 5.7vw, 5rem);
    font-weight: 400;
    letter-spacing: -0.06em;
    line-height: 1.03;
  }

  .research-page .hero h1 em { color: var(--teal); font-weight: 400; }

  .research-page .intro-copy {
    max-width: 620px;
    margin: 1.5rem 0 1.8rem;
    color: var(--muted);
    font-size: 0.96rem;
    line-height: 1.9;
  }

  .research-page .hero-link {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 0.95rem;
    border: 1px solid var(--teal);
    background: var(--teal);
    color: #fffef8;
    font-family: var(--font-mono, monospace);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-decoration: none;
    transition: transform 180ms ease, background 180ms ease;
  }

  .research-page .hero-link:hover { transform: translateY(-2px); background: #174f4b; }
  .research-page .hero-link span { color: #f0c87e; font-size: 1rem; }

  .research-page .hero-art {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    max-width: 340px;
    justify-self: center;
  }

  .research-page .orbit {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 78%;
    aspect-ratio: 1;
    border: 1px solid rgb(34 108 101 / 38%);
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }

  .research-page .orbit-one { transform: translate(-50%, -50%) rotate(-30deg) scaleX(0.46); border-color: var(--coral); }
  .research-page .orbit-two { transform: translate(-50%, -50%) rotate(36deg) scaleX(0.55); border-color: var(--teal); }
  .research-page .orbit-three { width: 94%; border-style: dashed; border-color: rgb(34 108 101 / 30%); }

  .research-page .orbit-core {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    width: 88px;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid rgb(255 255 255 / 65%);
    border-radius: 50%;
    background: linear-gradient(145deg, #2b7c72, #174b48);
    box-shadow: 0 12px 35px rgb(21 62 60 / 22%);
    color: #fff9e9;
    font-family: var(--font-serif, Georgia, serif);
    font-size: 1.8rem;
    transform: translate(-50%, -50%);
  }

  .research-page .art-label {
    position: absolute;
    color: var(--muted);
    font-family: var(--font-mono, monospace);
    font-size: 0.56rem;
    letter-spacing: 0.08em;
  }

  .research-page .art-label-one { top: 5%; right: 0; }
  .research-page .art-label-two { bottom: 12%; left: -2%; }
  .research-page .art-label-three { top: 15%; left: 8%; color: var(--coral); font-size: 1.7rem; }

  .research-page .publications-section,
  .research-page .archive-section,
  .research-page .about-archive { margin-top: 4.8rem; }

  .research-page .section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 1.5rem;
  }

  .research-page .section-heading .eyebrow { margin-bottom: 0.65rem; }

  .research-page .section-heading h2,
