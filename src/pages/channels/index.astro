---
import BaseLayout from '../../layouts/BaseLayout.astro';

const channels = [
  {
    number: '01',
    handle: '@GareebGymbrosPodcast',
    name: 'Gareeb Gymbros Podcast',
    platform: 'YouTube',
    category: 'Fitness · Conversations',
    intro:
      'A space for conversations around fitness, bodybuilding, training, and the culture that grows around them.',
    purpose:
      'To talk about the ideas, experiences, and people behind training—not just what happens in the gym, but the conversations around it.',
    topics: ['Fitness and bodybuilding', 'Training culture', 'Conversations and opinions'],
    accent: 'coral',
  },
  {
    number: '02',
    handle: '@InquisitiveStardust',
    name: 'Inquisitive Stardust',
    platform: 'YouTube',
    category: 'Science · Curiosity',
    intro:
      'A channel for exploring questions about the universe and the scientific ideas that help us make sense of it.',
    purpose:
      'To follow curiosity beyond quick answers and make room for questions about nature, physics, and our place in the cosmos.',
    topics: ['Physics and the universe', 'Scientific ideas', 'Questions worth exploring'],
    accent: 'blue',
  },
  {
    number: '03',
    handle: '@InquisitivePhilosopher',
    name: 'Inquisitive Philosopher',
    platform: 'YouTube',
    category: 'Philosophy · Ideas',
    intro:
      'A place for philosophical questions about human life, meaning, thought, and the assumptions we rarely stop to examine.',
    purpose:
      'To examine ideas carefully, explore different ways of seeing the world, and make difficult questions approachable without pretending they have easy answers.',
    topics: ['Philosophy and worldview', 'Meaning and existence', 'Ideas and arguments'],
    accent: 'green',
  },
  {
    number: '04',
    handle: '@Shivraj_Deshmukh',
    name: 'Shivraj Deshmukh',
    platform: 'YouTube',
    category: 'Personal · Creative work',
    intro:
      'My personal channel—a home for the work I choose to share under my own name.',
    purpose:
      'Not every interest fits neatly into one subject. This channel gives my own projects and creative work a place of their own.',
    topics: ['Personal projects', 'Creative work', 'Videos published under my name'],
    accent: 'violet',
  },
];

const instagram = {
  handle: '@shivraj._deshmukh',
  url: 'https://www.instagram.com/shivraj._deshmukh/',
};
---

<BaseLayout
  title="Channels & Media"
  description="My YouTube channels and Instagram: science, philosophy, fitness, and personal creative work."
  active="channels"
>
  <section class="page-intro media-intro">
    <div class="container">
      <span class="eyebrow kicker">Channels &amp; media</span>

      <h1>
        Different interests.<br />
        <span class="heading-accent">Different ways to explore them.</span>
      </h1>

      <p class="intro-copy">
        I like making things, exploring ideas, and sharing what interests me.
        Those interests don't all belong in the same place, so I've built
        different channels for different kinds of work—from fitness
        conversations to science, philosophy, and personal projects. This page
        brings them together.
      </p>

      <div class="intro-meta">
        <span>Four YouTube channels</span>
        <span>One Instagram account</span>
        <span>Latest videos below</span>
      </div>
    </div>
  </section>

  <section class="section-tight channel-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Video projects</span>
          <h2>Find your way in</h2>
        </div>
        <p class="section-intro">
          Each channel has its own subject and purpose. Choose the one that
          interests you, or browse the latest uploads here.
        </p>
      </div>

      <div class="channel-grid">
        {channels.map((channel) => (
          <article
            class={`channel-card accent-${channel.accent}`}
            id={`channel-${channel.number}`}
            data-channel-card
            data-handle={channel.handle}
            data-reveal
          >
            <div class="channel-topline">
              <span class="channel-number">{channel.number}</span>
              <span class="platform-label">
                <span class="youtube-mark" aria-hidden="true">▶</span>
                YouTube
              </span>
            </div>

            <div class="channel-identity">
              <div class="channel-avatar-wrap" aria-hidden="true">
                <span class="channel-avatar-fallback">
                  {channel.name.charAt(0)}
                </span>
                <img
                  class="channel-avatar"
                  data-channel-avatar
                  alt=""
                  loading="lazy"
                  decoding="async"
                  hidden
                />
              </div>

              <div class="channel-heading">
                <span class="eyebrow">{channel.category}</span>
                <h2>{channel.name}</h2>
                <p class="channel-handle">{channel.handle}</p>
              </div>
            </div>

            <p class="channel-intro">{channel.intro}</p>

            <div class="channel-details">
              <h3>What you'll find here</h3>
              <ul>
                {channel.topics.map((topic) => <li>{topic}</li>)}
              </ul>
            </div>

            <div class="channel-purpose">
              <span class="eyebrow">Why this channel exists</span>
              <p>{channel.purpose}</p>
            </div>

            <div class="latest-heading">
              <div>
                <span class="eyebrow">From the channel</span>
                <h3>Latest videos</h3>
              </div>

              <span class="live-label">
                <span class="live-dot"></span>
                Auto-updating
              </span>
            </div>

            <div class="video-list" data-video-list aria-live="polite">
              <p class="video-status">Loading recent uploads…</p>
            </div>

            <a
              class="channel-button"
              href={`https://www.youtube.com/${channel.handle}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              Visit channel <span aria-hidden="true">↗</span>
            </a>
          </article>
        ))}
      </div>

      <p class="feed-note">
        Recent uploads are retrieved from YouTube. If the video feed cannot be
        loaded, you can still visit each channel directly.
      </p>
    </div>
  </section>

  <section class="section-tight instagram-section">
    <div class="container instagram-panel" data-reveal>
      <div class="instagram-copy">
        <span class="eyebrow">Beyond YouTube</span>
        <h2>A little more personal.</h2>
        <p>
          Instagram is another place to find me. It sits alongside these
          projects as a more personal window into what I choose to share.
        </p>

        <a
          class="channel-button"
          href={instagram.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          Follow {instagram.handle} <span aria-hidden="true">↗</span>
        </a>
      </div>

      <a
        class="instagram-mark"
        href={instagram.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Open Instagram profile ${instagram.handle}`}
      >
        <span class="instagram-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <rect
              x="3"
              y="3"
              width="18"
              height="18"
              rx="5"
              stroke="currentColor"
              stroke-width="1.7"
            />
            <circle
              cx="12"
              cy="12"
              r="4"
              stroke="currentColor"
              stroke-width="1.7"
            />
            <circle cx="17.5" cy="6.8" r="1" fill="currentColor" />
          </svg>
        </span>

        <span class="instagram-name">{instagram.handle}</span>
        <span class="instagram-visit">Open Instagram ↗</span>
      </a>
    </div>
  </section>

  <section class="closing-banner">
    <div class="container closing-inner">
      <div>
        <span class="eyebrow">Explore the rest</span>
        <h2>There is more to what I do than what fits in a video.</h2>
      </div>

      <a class="button" href="/research/">
        Explore my research <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  const apiKey = import.meta.env.PUBLIC_YOUTUBE_API_KEY;
  const youtubeApi = 'https://www.googleapis.com/youtube/v3';

  async function getJson(url) {
    const response = await fetch(url);

    if (!response.ok) {
      throw new Error(`YouTube API returned ${response.status}`);
    }

    return response.json();
  }

  function addText(parent, tag, className, content) {
    const element = document.createElement(tag);
    element.className = className;
    element.textContent = content;
    parent.appendChild(element);
    return element;
  }

  function renderVideo(list, video) {
    const link = document.createElement('a');
    link.className = 'video-item';
    link.href = `https://www.youtube.com/watch?v=${encodeURIComponent(video.id)}`;
    link.target = '_blank';
    link.rel = 'noopener noreferrer';

    const thumbWrap = document.createElement('span');
    thumbWrap.className = 'video-thumb-wrap';

    const image = document.createElement('img');
    image.src = video.thumbnail;
    image.alt = '';
    image.loading = 'lazy';
    image.decoding = 'async';
    image.width = 320;
    image.height = 180;

    image.onerror = () => {
      image.src = `https://i.ytimg.com/vi/${encodeURIComponent(video.id)}/hqdefault.jpg`;
      image.onerror = null;
    };

    thumbWrap.appendChild(image);

    const play = document.createElement('span');
    play.className = 'video-play';
    play.textContent = '▶';
    play.setAttribute('aria-hidden', 'true');

    thumbWrap.appendChild(play);
    link.appendChild(thumbWrap);

    const text = document.createElement('span');
    text.className = 'video-text';

    addText(text, 'span', 'video-title', video.title);

    if (video.date) {
      const date = new Date(video.date);

      const readableDate = Number.isNaN(date.getTime())
        ? ''
        : new Intl.DateTimeFormat('en', {
            day: 'numeric',
            month: 'short',
            year: 'numeric',
          }).format(date);

      if (readableDate) {
        addText(text, 'span', 'video-date', readableDate);
      }
    }

    link.appendChild(text);
    list.appendChild(link);
  }

  async function loadChannelVideos(card) {
    const handle = card.dataset.handle;
    const list = card.querySelector('[data-video-list]');

    if (!list) return;

    if (!apiKey) {
      list.replaceChildren();

      addText(
        list,
        'p',
        'video-status',
        'Add your YouTube API key to load recent videos automatically.'
      );

      return;
    }

    try {
      const channelUrl = new URL(`${youtubeApi}/channels`);

      channelUrl.search = new URLSearchParams({
        part: 'snippet,contentDetails',
        forHandle: handle,
        key: apiKey,
      }).toString();

      const channelData = await getJson(channelUrl);

      if (!channelData.items || channelData.items.length === 0) {
        throw new Error('Channel not found');
      }

      const channel = channelData.items[0];

      // Load the real channel avatar, keeping the initial as a fallback.
      const avatar = card.querySelector('[data-channel-avatar]');
      const avatarWrap = card.querySelector('.channel-avatar-wrap');
      const channelThumbnails = channel.snippet?.thumbnails || {};

      const avatarUrl =
        channelThumbnails.high?.url ||
        channelThumbnails.medium?.url ||
        channelThumbnails.default?.url;

      if (avatar && avatarWrap && avatarUrl) {
        avatar.onload = () => {
          avatar.hidden = false;
          avatarWrap.classList.add('has-avatar');
        };

        avatar.onerror = () => {
          avatar.hidden = true;
          avatarWrap.classList.remove('has-avatar');
        };

        avatar.src = avatarUrl;
      }

      const uploadsPlaylist =
        channel.contentDetails?.relatedPlaylists?.uploads;

      if (!uploadsPlaylist) {
        throw new Error('Uploads playlist unavailable');
      }

      const playlistUrl = new URL(`${youtubeApi}/playlistItems`);

      playlistUrl.search = new URLSearchParams({
        part: 'snippet,contentDetails',
        playlistId: uploadsPlaylist,
        maxResults: '3',
        key: apiKey,
      }).toString();

      const playlistData = await getJson(playlistUrl);

      const videos = (playlistData.items || [])
        .filter((item) => item.snippet?.resourceId?.videoId)
        .map((item) => {
          const snippet = item.snippet;
          const thumbnails = snippet.thumbnails || {};

          return {
            id: snippet.resourceId.videoId,
            title: snippet.title || 'Untitled video',
            date: snippet.publishedAt || '',
            thumbnail:
              thumbnails.maxres?.url ||
              thumbnails.high?.url ||
              thumbnails.medium?.url ||
              thumbnails.default?.url ||
              `https://i.ytimg.com/vi/${snippet.resourceId.videoId}/hqdefault.jpg`,
          };
        });

      list.replaceChildren();

      if (!videos.length) {
        addText(list, 'p', 'video-status', 'No public uploads found yet.');
        return;
      }

      videos.forEach((video) => renderVideo(list, video));
    } catch (error) {
      console.error(`Could not load videos for ${handle}:`, error);

      list.replaceChildren();

      addText(
        list,
        'p',
        'video-status',
        'Recent videos could not be loaded. Visit the channel to see its uploads.'
      );
    }
  }

  async function refreshVideoLists() {
    const cards = [...document.querySelectorAll('[data-channel-card]')];

    await Promise.all(cards.map((card) => loadChannelVideos(card)));
  }

  refreshVideoLists();
</script>

<style is:global>
  .media-intro {
    padding-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }

  .heading-accent {
    color: var(--green);
  }

  .channel-section {
    padding-top: 0;
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--line, rgba(127, 127, 127, 0.25));
  }

  .section-heading h2 {
    margin: 0.4rem 0 0;
  }

  .section-intro {
    max-width: 460px;
    margin: 0;
    color: var(--muted, #777);
    font-size: 0.95rem;
    line-height: 1.75;
  }

  .channel-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .channel-card {
    --channel-accent: var(--coral);
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(1.15rem, 2.2vw, 1.8rem);
    overflow: hidden;
    border: 1px solid var(--line, rgba(127, 127, 127, 0.25));
    border-radius: 12px;
    background: var(--surface, transparent);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.035);
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .channel-card::before {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: var(--channel-accent);
    content: '';
    opacity: 0.9;
  }

  .channel-card:hover {
    border-color: color-mix(
      in srgb,
      var(--channel-accent) 45%,
      var(--line, #ccc)
    );
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.07);
    transform: translateY(-2px);
  }

  .accent-coral {
    --channel-accent: var(--coral);
  }

  .accent-blue {
    --channel-accent: #6494ce;
  }

  .accent-green {
    --channel-accent: var(--green);
  }

  .accent-violet {
    --channel-accent: #9b83c7;
  }

  .channel-topline,
  .latest-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .channel-number {
    color: var(--channel-accent);
    font-size: 0.78rem;
    font-weight: 750;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
  }

  .platform-label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--muted, #777);
    font-size: 0.76rem;
  }

  .youtube-mark {
    display: inline-grid;
    width: 1.35rem;
    height: 0.95rem;
    place-items: center;
    border-radius: 4px;
    background: #ff0033;
    color: white;
    font-size: 0.6rem;
  }

  .channel-identity {
    display: grid;
    grid-template-columns: 4.25rem minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .channel-avatar-wrap {
    position: relative;
    display: grid;
    width: 4.25rem;
    aspect-ratio: 1;
    place-items: center;
    overflow: hidden;
    border: 1px solid color-mix(
      in srgb,
      var(--channel-accent) 38%,
      transparent
    );
    border-radius: 50%;
    background: color-mix(
      in srgb,
      var(--channel-accent) 12%,
      var(--surface, white)
    );
    color: var(--channel-accent);
  }

  .channel-avatar-fallback {
    font-size: 1.6rem;
    font-weight: 750;
    line-height: 1;
  }

  .channel-avatar {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    object-fit: cover;
  }

  .channel-heading {
    min-width: 0;
  }

  .channel-heading .eyebrow {
    color: var(--channel-accent);
  }

  .channel-heading h2 {
    margin: 0.4rem 0 0.35rem;
    font-size: clamp(1.35rem, 2vw, 1.85rem);
    line-height: 1.15;
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
  }

  .channel-handle {
    margin: 0;
    color: var(--muted, #777);
    font-size: 0.78rem;
    overflow-wrap: anywhere;
  }

  .channel-intro {
    margin: 1.15rem 0 1.25rem;
    font-size: 0.93rem;
    line-height: 1.75;
  }

  .channel-details {
    padding: 1rem 0 1.15rem;
    border-top: 1px solid var(--line, rgba(127, 127, 127, 0.25));
  }

  .channel-details h3,
  .latest-heading h3 {
    margin: 0;
    font-size: 0.98rem;
    font-weight: 700;
  }

  .channel-details ul {
    display: grid;
    gap: 0.35rem;
    margin: 0.65rem 0 0;
    padding-left: 1.1rem;
    color: var(--muted, #777);
    font-size: 0.86rem;
    line-height: 1.6;
  }

  .channel-details li::marker {
    color: var(--channel-accent);
  }

  .channel-purpose {
    padding: 0.95rem 1rem;
    border-left: 2px solid var(--channel-accent);
    border-radius: 0 6px 6px 0;
    background: color-mix(
      in srgb,
      var(--channel-accent) 6%,
      var(--background, transparent)
    );
  }

  .channel-purpose p {
    margin: 0.45rem 0 0;
    color: var(--muted, #777);
    font-size: 0.86rem;
    line-height: 1.7;
  }

  .latest-heading {
    margin-top: 1.65rem;
    align-items: flex-end;
  }

  .latest-heading .eyebrow {
    display: block;
    margin-bottom: 0.3rem;
    color: var(--muted, #777);
  }

  .live-label {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--muted, #777);
    font-size: 0.7rem;
    white-space: nowrap;
  }

  .live-dot {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--green) 14%, transparent);
  }

  .video-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: 0.7rem;
    margin-top: 0.85rem;
  }

  .video-item {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.55rem;
    color: var(--ink, inherit);
    text-decoration: none;
  }

  .video-thumb-wrap {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-radius: 7px;
    background: var(--background, #ddd);
  }

  .video-item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 220ms ease;
  }

  .video-play {
    position: absolute;
    right: 0.45rem;
    bottom: 0.45rem;
    display: grid;
    width: 1.7rem;
    height: 1.2rem;
    place-items: center;
    border-radius: 4px;
    background: rgba(15, 15, 15, 0.85);
    color: white;
    font-size: 0.65rem;
    transition: background 180ms ease;
  }

  .video-text {
    display: grid;
    align-content: start;
    gap: 0.35rem;
    min-width: 0;
  }

  .video-title {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    font-size: 0.78rem;
    font-weight: 650;
    line-height: 1.45;
  }

  .video-date {
    color: var(--muted, #777);
    font-size: 0.7rem;
    line-height: 1.4;
  }

  .video-item:hover img {
    transform: scale(1.045);
  }

  .video-item:hover .video-title {
    color: var(--channel-accent);
  }

  .video-item:hover .video-play {
    background: #ff0033;
  }

  .video-status {
    grid-column: 1 / -1;
    margin: 0;
    padding: 1rem 0;
    color: var(--muted, #777);
    font-size: 0.85rem;
    line-height: 1.65;
  }

  .channel-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    gap: 0.65rem;
    margin-top: auto;
    padding: 0.7rem 0.95rem;
    border: 1px solid var(--line, rgba(127, 127, 127, 0.3));
    border-radius: 6px;
    color: var(--ink, inherit);
    font-size: 0.82rem;
    font-weight: 650;
    text-decoration: none;
    transition:
      border-color 160ms ease,
      color 160ms ease,
      background 160ms ease;
  }

  .channel-card > .channel-button {
    margin-top: 1.25rem;
  }

  .channel-button:hover {
    border-color: var(--channel-accent, var(--green));
    background: color-mix(
      in srgb,
      var(--channel-accent, var(--green)) 7%,
      transparent
    );
    color: var(--channel-accent, var(--green));
  }

  .feed-note {
    margin: 1.25rem 0 0;
    color: var(--muted, #777);
    font-size: 0.82rem;
    line-height: 1.7;
  }

  .instagram-section {
    padding-top: 0.5rem;
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .instagram-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 0.65fr);
    align-items: center;
    gap: 3rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid var(--line, rgba(127, 127, 127, 0.25));
    border-radius: 12px;
    background: var(--surface, transparent);
  }

  .instagram-copy h2 {
    margin: 0.6rem 0 0.9rem;
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    letter-spacing: -0.035em;
  }

  .instagram-copy > p {
    max-width: 500px;
    margin: 0;
    color: var(--muted, #777);
    font-size: 0.96rem;
    line-height: 1.8;
  }

  .instagram-mark {
    display: grid;
