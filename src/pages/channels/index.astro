---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { channelCards } from '../../data/siteContent';
---
<BaseLayout title="Channels & media" description="A directory of video channels and social media, with each channel's content and purpose explained." active="channels">
  <section class="page-intro">
    <div class="container">
      <span class="eyebrow kicker">Channels & media / places I publish</span>
      <h1>Different channels.<br /><span style="color: var(--green)">Different reasons.</span></h1>
      <p class="intro-copy">A directory for four YouTube channels and one Instagram account. Each card explains the subject, typical content, and purpose — not just where to click.</p>
      <div class="intro-meta"><span>04 YouTube slots</span><span>01 Instagram slot</span><span>Purpose before link</span></div>
    </div>
  </section>
  <section class="section-tight" style="padding-top: 0">
    <div class="container">
      <div class="notice"><span class="notice-mark">i</span><div>The channel names and descriptions below are suggested starting templates based on the broad interests already discussed. Replace them with the exact public names, descriptions, and links for your real accounts before launch.</div></div>
      <div class="channel-grid">
        {channelCards.map((channel) => (
          <article class="channel-card" data-reveal>
            <div class="channel-card-head"><span class="platform-tag">{channel.platform} / {channel.role}</span><span class="channel-number">{channel.number}</span></div>
            <div class="channel-glyph" aria-hidden="true">{channel.platform === 'Instagram' ? '◎' : '▷'}</div>
            <h2>{channel.title}</h2>
            <p>{channel.description}</p>
            <div class="channel-info">
              <div><h3>What appears here</h3><ul>{channel.content.map((item) => <li>{item}</li>)}</ul></div>
              <div><h3>Why this channel exists</h3><div class="channel-purpose">{channel.purpose}</div></div>
            </div>
            <div class="channel-bottom"><span class="sample-label">{channel.sample ? 'Starter copy — personalize' : 'Channel profile'}</span>{channel.url ? <a class="text-link" href={channel.url} target="_blank" rel="noopener noreferrer">Visit channel ↗</a> : <span class="link-placeholder">Add account link</span>}</div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
