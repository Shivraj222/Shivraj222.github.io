---
const { active = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
const links = [
  { label: 'Research', href: `${base}research/`, key: 'research' },
  { label: 'Writings', href: `${base}writings/`, key: 'writings' },
  { label: 'Channels', href: `${base}channels/`, key: 'channels' },
  { label: 'Art & photos', href: `${base}art/`, key: 'art' },
  { label: 'About', href: `${base}about/`, key: 'about' },
];
---
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={base} aria-label="Home">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 40 40" role="img">
          <ellipse cx="20" cy="20" rx="15" ry="6.7" transform="rotate(-36 20 20)" fill="none" stroke="currentColor" stroke-width="1.7" />
          <ellipse cx="20" cy="20" rx="15" ry="6.7" transform="rotate(36 20 20)" fill="none" stroke="currentColor" stroke-width="1.7" />
          <circle cx="20" cy="20" r="3.6" fill="#e6bd59" />
        </svg>
      </span>
      <span class="brand-copy"><strong>SHIVRAJ DESHMUKH</strong><small>physics · writing · life</small></span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav">
      <span></span><span></span><span class="sr-only">Toggle navigation</span>
    </button>
    <nav class="primary-nav" id="primary-nav" aria-label="Main navigation">
      {links.map((link) => (
        <a href={link.href} class:list={{ active: active === link.key }} aria-current={active === link.key ? 'page' : undefined}>{link.label}</a>
      ))}
    </nav>
  </div>
</header>
<script>
  const menuButton = document.querySelector('.menu-toggle');
  const nav = document.querySelector('#primary-nav');
  menuButton?.addEventListener('click', () => {
    const open = menuButton.getAttribute('aria-expanded') === 'true';
    menuButton.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('is-open', !open);
  });
</script>
