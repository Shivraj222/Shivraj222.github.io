---
const { entry } = Astro.props;
const typeLabels = {
  project: 'Research project', publication: 'Publication', preprint: 'Preprint / manuscript',
  note: 'Technical note', writing: 'Academic writing', presentation: 'Talk / presentation', reading: 'Reading & references',
};
---
<article class="research-card" data-research-card data-type={entry.type} data-status={entry.status.toLowerCase()} data-search={`${entry.title} ${entry.description} ${entry.topics.join(' ')} ${entry.status} ${typeLabels[entry.type]}`.toLowerCase()} data-reveal>
  <div class="research-card-top">
    <span class="eyebrow card-type">{typeLabels[entry.type] ?? entry.type}</span>
    <span class={`status-pill status-${entry.status.toLowerCase().replaceAll(' ', '-')}`} data-status-label>{entry.status}</span>
  </div>
  <h3>{entry.title}</h3>
  <p>{entry.description}</p>
  <div class="card-meta">
    <span>{entry.maturity}</span>
    {entry.sample && <span class="sample-label">Sample entry</span>}
  </div>
  <div class="tag-row">
    {entry.topics.map((topic) => <span class="topic-tag">{topic}</span>)}
  </div>
  <div class="research-card-bottom">
    <span class="related-text">{entry.related}</span>
    <div class="document-links">
      {entry.pdfUrl ? (
        <a class="text-link" href={entry.pdfUrl} target="_blank" rel="noopener noreferrer">Open / download PDF ↗</a>
      ) : (
        <span class="link-placeholder">PDF link not added</span>
      )}
      {entry.externalUrl && <a class="text-link source-link" href={entry.externalUrl} target="_blank" rel="noopener noreferrer">Source / record ↗</a>}
    </div>
  </div>
</article>
